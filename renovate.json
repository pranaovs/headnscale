{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "internalChecksFilter": "none",
  "prHourlyLimit": 5,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": "0 days",
    "automerge": true,
    "automergeStrategy": "fast-forward",
    "labels": [
      "security"
    ]
  },
  "labels": [
    "dependencies",
    "renovate"
  ],
  "pinDigests": true,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "description": "Automerge minor/patch updates after stability delay",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin"
      ],
      "automerge": true,
      "automergeStrategy": "fast-forward",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Automerge docker digest updates immediately (no stability delay)",
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true,
      "automergeStrategy": "fast-forward"
    },
    {
      "description": "Don't pin digests for docker-compose.yml",
      "matchFileNames": [
        "docker-compose.yml"
      ],
      "pinDigests": false
    }
  ]
}
